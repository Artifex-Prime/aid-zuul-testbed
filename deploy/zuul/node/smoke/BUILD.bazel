load(":smoke.bzl", "farm_test")

platform(
    name = "farm",
    constraint_values = ["@platforms//cpu:x86_64", "@platforms//os:linux"],
    exec_properties = {
        "OSFamily": "linux",
        "OSRelease": "ubuntu26.04",
        "SwiftVersion": "6.4.0",
    },
)

farm_test(name = "remote_smoke")

# Declared source inputs for the parent workspace's Node image-policy tests.
filegroup(
    name = "node_inputs",
    srcs = glob(["**", ".*"], allow_empty = True),
    visibility = ["//:__pkg__"],
)
